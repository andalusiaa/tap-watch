# Keep secrets, local state and generated files out of git.

# Secrets and local environment values (never commit these)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# Cloudflare Wrangler local state (local database copies, caches)
.wrangler/

# Dependencies
node_modules/

# Build output
dist/

# Seed script downloads (raw OpenStreetMap data)
seed/raw/
*.osm.pbf

# Logs
*.log
npm-debug.log*

# OS and editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Personal Claude Code settings
.claude/settings.local.json
.claude/launch.json
