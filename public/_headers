# Security headers for every static page (see SPEC section 9).
# Note: these only apply to static files. The API adds its own headers in code.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.postcodes.io; img-src 'self' data: blob:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Map tiles and label fonts. Labelled as protobuf so Cloudflare compresses them.
# Tile folders are named after the map build date, so they never change.
/map/tiles/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=31536000, immutable

/map/fonts/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=604800
