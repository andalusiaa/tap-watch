# Security headers for every static page (see SPEC section 9).
# Note: these only apply to static files. The API adds its own headers in code.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.postcodes.io; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
